// ============================================================================
// Alloy Configuration for LGTM Stack on internal.lan
//
// Collects:
//   - OpenWrt syslog (UDP 514) -> Loki
//   - Docker container logs -> Loki
//   - systemd journal logs -> Loki
//   - OTLP traces (gRPC/HTTP) -> Tempo
//
// Note: metrics scraping is NOT Alloy's job — Prometheus is the sole metrics
// collector (label-gated docker_sd in config/prometheus/prometheus.yaml).
// ============================================================================

// 1. Promote syslog header fields to labels
loki.relabel "syslog_attrs" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }

  // Normalize the raw RFC5424 severity to Loki's canonical vocabulary
  // (trace|debug|info|warn|error|fatal). Relabel rules run in order and the
  // regex is fully anchored; values that match no rule pass through raw.
  rule {
    source_labels = ["level"]
    regex         = "emerg|emergency|alert|crit|critical|panic"
    target_label  = "level"
    replacement   = "fatal"
  }
  rule {
    source_labels = ["level"]
    regex         = "err|error"
    target_label  = "level"
    replacement   = "error"
  }
  rule {
    source_labels = ["level"]
    regex         = "warn|warning"
    target_label  = "level"
    replacement   = "warn"
  }
  rule {
    source_labels = ["level"]
    regex         = "info|informational|notice"
    target_label  = "level"
    replacement   = "info"
  }
  rule {
    source_labels = ["level"]
    regex         = "debug"
    target_label  = "level"
    replacement   = "debug"
  }
}

// 2. Receive OpenWrt syslog over UDP
loki.source.syslog "openwrt" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "openwrt" }
  }

  relabel_rules = loki.relabel.syslog_attrs.rules
  forward_to    = [loki.process.parse_openwrt.receiver]
}

// 3. Parse the dnsmasq / dnsmasq-dhcp / mwan3 / hostapd / firewall bodies
loki.process "parse_openwrt" {
  forward_to = [loki.write.loki_endpoint.receiver]

  // ---- dnsmasq: "<id> <client>/<port> <body>" ----
  stage.regex {
    expression = "^(?P<dns_id>[0-9]+) (?P<dns_client>[0-9A-Fa-f:.]+)/(?P<dns_port>[0-9]+) (?P<dns_body>.+)$"
  }
  stage.regex {
    source     = "dns_body"
    expression = "^(?P<dns_action>query)\\[(?P<dns_qtype>[^\\]]+)\\] (?P<dns_domain>\\S+) from (?P<dns_from>\\S+)$"
  }
  stage.regex {
    source     = "dns_body"
    expression = "^(?P<dns_action>forwarded|cached|reply|config) (?P<dns_domain>\\S+) (?:to|is) (?P<dns_value>\\S+)$"
  }
  stage.regex {
    source     = "dns_body"
    expression = "^(?P<dns_source>/\\S+) (?P<dns_domain>\\S+) is (?P<dns_answer>\\S+)$"
  }

  // ---- dnsmasq-dhcp ----
  stage.regex {
    expression = "^(?P<dhcp_action>DHCP[A-Z]+)\\((?P<dhcp_iface>[^)]+)\\) (?P<dhcp_ip>\\S+) (?P<dhcp_mac>\\S+)(?: (?P<dhcp_hostname>.+?)(?:\\.lan)?)?$"
  }
  stage.match {
    selector = "{app=\"dnsmasq-dhcp\"}"
    stage.template {
      source   = "dhcp_name"
      template = "{{ if .dhcp_hostname }}{{ .dhcp_hostname }}{{ else }}{{ .dhcp_ip }}{{ end }}"
    }
  }

  // ---- mwan3track ----
  stage.regex {
    expression = "^Check \\((?P<mwan3_check>[a-z]+)\\) (?P<mwan3_result>failed|success) for target \"(?P<mwan3_target>[^\"]+)\" on interface (?P<mwan3_iface>\\S+) \\((?P<mwan3_device>[^)]+)\\)\\. Current score: (?P<mwan3_score>\\d+)$"
  }
  stage.regex {
    expression = "^Lost (?P<mwan3_lost>\\d+) ping\\(s\\) on interface (?P<mwan3_iface>\\S+) \\((?P<mwan3_device>[^)]+)\\)\\. Current score: (?P<mwan3_score>\\d+)$"
  }
  stage.regex {
    expression = "^Interface (?P<mwan3_iface>\\S+) \\((?P<mwan3_device>[^)]+)\\) is (?P<mwan3_state>.+)$"
  }
  stage.regex {
    expression = "^Execute (?P<mwan3_event>connected|disconnected) event on interface (?P<mwan3_iface>\\S+) \\((?P<mwan3_device>[^)]+)\\)$"
  }

  // ---- hostapd Wi-Fi station events ----
  stage.regex {
    expression = "^(?P<wifi_iface>(?P<wifi_phy>phy[0-9]+)-ap(?P<wifi_band>[0-9]+)): AP-STA-(?P<wifi_event>CONNECTED|DISCONNECTED) (?P<sta_mac>[0-9a-fA-F:]+)"
  }
  stage.regex {
    expression = "^(?P<wifi_iface>(?P<wifi_phy>phy[0-9]+)-ap(?P<wifi_band>[0-9]+)): STA (?P<sta_mac>[0-9a-fA-F:]+) IEEE 802\\.11: (?P<wifi_state>associated|authenticated|disassociated|deauthenticated)"
  }

  // ---- fw4 / kernel firewall logs (app=kernel) ----
  stage.regex {
    expression = "^(?:\\[(?P<klog_ts>[0-9.]+)\\] )?(?:(?P<fw_label>[^:]+): )?IN=(?P<in_if>\\S*) OUT=(?P<out_if>\\S*) (?:MAC=(?P<mac>\\S+) )?SRC=(?P<src_ip>\\S+) DST=(?P<dst_ip>\\S+) LEN=(?P<pkt_len>\\d+) TOS=\\S+ PREC=\\S+ TTL=(?P<ttl>\\d+) ID=\\d+.*?PROTO=(?P<proto>[A-Za-z0-9]+)(?: SPT=(?P<src_port>\\d+) DPT=(?P<dst_port>\\d+))?"
  }
  stage.regex {
    expression = "WINDOW=\\d+ RES=\\S+ (?P<tcp_flags>[A-Z][A-Z ]*)(?: URGP=\\d+)?(?: MARK=(?P<mark>\\S+))?$"
  }
  stage.regex {
    expression = "SRC=(?P<src_ip>[^\\s]+)\\s+DST=(?P<dst_ip>[^\\s]+).+PROTO=(?P<proto>[^\\s]+)(\\s+SPT=(?P<src_port>\\d+)\\s+DPT=(?P<dst_port>\\d+))?"
  }

  // ---- dnscrypt-proxy ----
  stage.match {
    selector = "{app=\"dnscrypt-proxy\"} |= \"duration:\""
    stage.static_labels { values = { dns_action = "query" } }
    stage.regex {
      expression = "^time:(?P<dns_ts>\\d+)\\thost:(?P<dns_client>[^\\t]+)\\tmessage:(?P<dns_domain>[^\\t]+)\\ttype:(?P<dns_qtype>[^\\t]+)\\treturn:(?P<dns_return>[^\\t]+)\\tcached:(?P<dns_cached>\\d+)\\tduration:(?P<dns_duration>\\d+)\\tserver:(?P<dns_server>[^\\t]*)(?:\\trelay:[^\\t]*)?$"
    }
  }
  stage.match {
    selector = "{app=\"dnscrypt-proxy\"} |~ \"type:[A-Za-z0-9]+$\""
    stage.static_labels { values = { dns_action = "nx" } }
    stage.regex {
      expression = "^time:(?P<dns_ts>\\d+)\\thost:(?P<dns_client>[^\\t]+)\\tmessage:(?P<dns_domain>[^\\t]+)\\ttype:(?P<dns_qtype>[^\\t]+)$"
    }
  }
  stage.match {
    selector = "{app=\"dnscrypt-proxy\"} |= \"qname:\""
    stage.static_labels { values = { dns_action = "allowed" } }
    stage.regex {
      expression = "^time:(?P<dns_ts>\\d+)\\thost:(?P<dns_client>[^\\t]+)\\tqname:(?P<dns_domain>[^\\t]+)\\tmessage:(?P<dns_reason>.*)$"
    }
  }
  stage.match {
    selector = "{app=\"dnscrypt-proxy\"} |~ \"^.[0-9]{4}-[0-9]{2}-[0-9]{2} \""
    stage.static_labels { values = { dns_action = "blocked" } }
    stage.regex {
      expression = "^\\[(?P<dns_ts>[^\\]]+)\\]\\t(?P<dns_client>[^\\t]+)\\t(?P<dns_domain>[^\\t]+)\\t(?P<dns_reason>.*)$"
    }
  }

  // ---- dropbear SSH ----
  stage.match {
    selector = "{app=\"dropbear\"} |= \"Child connection from\""
    stage.static_labels { values = { db_event = "connect" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"} |= \"auth succeeded\""
    stage.static_labels { values = { db_event = "auth_success" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"} |~ \"Bad password attempt|Login attempt|bad signature|Too-long password|rejected|is locked|blank password\""
    stage.static_labels { values = { db_event = "auth_failed" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"} |= \"Exit (\""
    stage.static_labels { values = { db_event = "exit" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"} |= \"Pubkey auth\""
    stage.static_labels { values = { db_method = "pubkey" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"} |~ \"Password auth|Bad password|Too-long password|blank password\""
    stage.static_labels { values = { db_method = "password" } }
  }
  stage.match {
    selector = "{app=\"dropbear\"}"
    stage.regex { expression = "for '(?P<db_user>[^']+)'" }
    stage.regex { expression = "^Exit \\((?P<db_user>[^)]+)\\) from " }
    stage.regex { expression = "^Login attempt with wrong user (?P<db_user>\\S+) from " }
    stage.regex { expression = "with (?P<db_key_type>\\S+) key (?P<db_key_fp>\\S+) from " }
    stage.regex { expression = "with key (?P<db_key_fp>\\S+) from " }
    stage.regex { expression = "from [<\\[]?(?P<src_ip>[0-9A-Fa-f:.]+)[>\\]]?:(?P<src_port>\\d+)" }
    stage.regex { expression = "^Exit \\([^)]+\\) from \\S+(?: (?P<db_reason>.*))?$" }
  }

  // low-cardinality fields -> indexed labels
  stage.labels {
    values = {
      dns_action = "dns_action",
      dns_qtype  = "dns_qtype",
      proto      = "proto",
      db_event   = "db_event",
      db_method  = "db_method",
    }
  }

  // high-cardinality fields -> structured metadata
  stage.structured_metadata {
    values = {
      dns_query_id  = "dns_id",
      dns_client    = "dns_client",
      dns_domain    = "dns_domain",
      dns_value     = "dns_value",
      dns_answer    = "dns_answer",
      dns_source    = "dns_source",
      dhcp_action   = "dhcp_action",
      dhcp_iface    = "dhcp_iface",
      dhcp_ip       = "dhcp_ip",
      dhcp_mac      = "dhcp_mac",
      dhcp_hostname = "dhcp_hostname",
      dhcp_name     = "dhcp_name",
      mwan3_check   = "mwan3_check",
      mwan3_result  = "mwan3_result",
      mwan3_target  = "mwan3_target",
      mwan3_iface   = "mwan3_iface",
      mwan3_device  = "mwan3_device",
      mwan3_score   = "mwan3_score",
      mwan3_lost    = "mwan3_lost",
      mwan3_state   = "mwan3_state",
      mwan3_event   = "mwan3_event",
      wifi_iface    = "wifi_iface",
      wifi_phy      = "wifi_phy",
      wifi_band     = "wifi_band",
      wifi_event    = "wifi_event",
      wifi_state    = "wifi_state",
      sta_mac       = "sta_mac",
      src_ip        = "src_ip",
      dst_ip        = "dst_ip",
      src_port      = "src_port",
      dst_port      = "dst_port",
      in_if         = "in_if",
      out_if        = "out_if",
      fw_label      = "fw_label",
      mac           = "mac",
      pkt_len       = "pkt_len",
      ttl           = "ttl",
      tcp_flags     = "tcp_flags",
      mark          = "mark",
      klog_ts       = "klog_ts",
      dns_ts        = "dns_ts",
      dns_return    = "dns_return",
      dns_cached    = "dns_cached",
      dns_duration  = "dns_duration",
      dns_server    = "dns_server",
      dns_reason    = "dns_reason",
      db_user       = "db_user",
      db_key_type   = "db_key_type",
      db_key_fp     = "db_key_fp",
      db_reason     = "db_reason",
    }
  }
}

// ============================================================================
// DOCKER CONTAINER LOGS
// ============================================================================

// Discover all Docker containers for logs
discovery.docker "logs" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

// Relabel Docker discovery targets for Loki logs.
// Label names are unified with Prometheus target labels:
//   project, service_name, container_name, container_id (moved to structured
//   metadata in loki.process below), job (log source axis, always "docker").
// Note: there is no image label — discovery.docker exports no image meta-label
// (container_image exists on metrics only).
discovery.relabel "docker_logs" {
  targets = discovery.docker.logs.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container_name"
    regex         = "/(.*)"
    replacement   = "${1}"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  rule {
    target_label  = "job"
    replacement   = "docker"
  }
}

// Collect Docker container logs
loki.source.docker "containers" {
  host      = "unix:///var/run/docker.sock"
  targets   = discovery.relabel.docker_logs.output
  forward_to = [loki.process.docker_logs.receiver]
}

// Process Docker logs
// - container_id label -> structured metadata (moves it out of the stream
//   label set: no stream fork on container recreate, zero index cost;
//   still queryable with | container_id="...")
// - per-service level extraction: known services get a normalized `level`
//   stream label (trace|debug|info|warn|error|fatal); low-cardinality extras
//   (component/target/pid/pg_severity/logger/caller/source/method/status)
//   go to structured metadata. Log lines are never rewritten — only
//   dockhand's non-timestamped noise (stack traces, startup chatter) is
//   dropped.
loki.process "docker_logs" {
  forward_to = [loki.write.loki_endpoint.receiver]

  // arcane and dbx colorize their output — strip ANSI codes before parsing
  stage.decolorize {}

  stage.structured_metadata {
    values = {
      container_id = "",
    }
  }

  // ---- arcane (zerolog console): "Sep 28 19:00:11.801 INF message key=val";
  //      Go stdlib fallback (signal handler): "2026/09/28 19:00:11 INFO msg" ----
  stage.match {
    selector = "{container_name=\"arcane\"}"
    stage.regex {
      expression = "^(?:[A-Z][a-z]{2}  ?\\d{1,2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3} +|\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} +)(?P<level_raw>TRC|DBG|INF|WRN|ERR|FTL|PNC|TRACE|DEBUG|INFO|WARN|ERROR|FATAL) "
    }
  }

  // ---- dbx (tracing): "2026-09-28T11:50:42.590366Z  INFO dbx_web: message" ----
  stage.match {
    selector = "{container_name=\"dbx\"}"
    stage.regex {
      expression = "^\\d{4}-\\d{2}-\\d{2}T\\S+ +(?P<level_raw>TRACE|DEBUG|INFO|WARN|ERROR) +(?:(?P<target>[A-Za-z0-9_:]+): +)?"
    }
  }

  // ---- dockhand: logger lines start with an ISO timestamp; drop everything
  // else (stack-trace continuations, [tag] / banner startup chatter) ----
  stage.match {
    selector = "{container_name=\"dockhand\"}"
    stage.drop {
      expression          = "^(?:$|[^0-9])"
      drop_counter_reason = "dockhand_noise"
    }
    stage.regex {
      expression = "^\\S+ +(?P<level_raw>INFO|WARN|WARNING|ERROR|DEBUG|TRACE|FATAL) +(?:(?:\\[(?P<component>[^\\]]+)\\]) +)?"
    }
  }

  // ---- postgres: "2026-09-28 06:46:02.017 WIB [56] LOG:  message" ----
  stage.match {
    selector = "{container_name=~\"manager-db|grafana-db\"}"
    // docker-entrypoint.sh prints non-log chatter ("PostgreSQL Database
    // directory..." banner, blank lines); server log lines always start
    // with a date — drop the rest
    stage.drop {
      expression          = "^(?:$|[^0-9])"
      drop_counter_reason = "postgres_noise"
    }
    stage.regex {
      expression = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3} [^ ]+ (?:\\[(?P<pid>\\d+)\\] )?(?P<level_raw>LOG|NOTICE|WARNING|ERROR|FATAL|PANIC|INFO|DEBUG\\d?|DETAIL|HINT|STATEMENT|CONTEXT):"
    }
    // the raw keyword is the interesting part of aux lines (DETAIL/STATEMENT/...)
    stage.structured_metadata {
      values = {
        pg_severity = "level_raw",
        pid         = "pid",
      }
    }
  }

  // ---- logfmt: grafana, prometheus, alloy, tempo, loki ----
  stage.match {
    selector = "{container_name=~\"grafana|grafana-alloy|grafana-tempo|loki|prometheus\"}"
    stage.logfmt {
      mapping = {
        level_raw = "level",
        logger    = "logger",
        component = "component",
        caller    = "caller",
        source    = "source",
      }
    }
  }

  // ---- traefik JSON (access + app logs) ----
  stage.match {
    selector = "{container_name=\"traefik\"}"
    stage.json {
      expressions = {
        level_raw = "level",
        method    = "RequestMethod",
        status    = "DownstreamStatus",
      }
    }
  }

  // normalize the extracted raw keyword to Loki's canonical vocabulary;
  // writes level="" when nothing was extracted (Loki drops empty labels)
  stage.template {
    source = "level"
    template = "{{ if .level_raw }}{{ $r := ToLower .level_raw }}{{ if eq $r \"trc\" }}trace{{ else if eq $r \"trace\" }}trace{{ else if eq $r \"dbg\" }}debug{{ else if eq $r \"debug\" }}debug{{ else if eq $r \"debug1\" }}debug{{ else if eq $r \"debug2\" }}debug{{ else if eq $r \"debug3\" }}debug{{ else if eq $r \"debug4\" }}debug{{ else if eq $r \"debug5\" }}debug{{ else if eq $r \"inf\" }}info{{ else if eq $r \"info\" }}info{{ else if eq $r \"log\" }}info{{ else if eq $r \"notice\" }}info{{ else if eq $r \"detail\" }}info{{ else if eq $r \"hint\" }}info{{ else if eq $r \"statement\" }}info{{ else if eq $r \"context\" }}info{{ else if eq $r \"wrn\" }}warn{{ else if eq $r \"warn\" }}warn{{ else if eq $r \"warning\" }}warn{{ else if eq $r \"err\" }}error{{ else if eq $r \"error\" }}error{{ else if eq $r \"ftl\" }}fatal{{ else if eq $r \"fatal\" }}fatal{{ else if eq $r \"pnc\" }}fatal{{ else if eq $r \"panic\" }}fatal{{ else }}{{ $r }}{{ end }}{{ end }}"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }

  stage.structured_metadata {
    values = {
      target    = "target",
      component = "component",
      logger    = "logger",
      caller    = "caller",
      source    = "source",
      method    = "method",
      status    = "status",
    }
  }
}

// Promote the journal PRIORITY keyword to a level label and normalize it to
// the same canonical vocabulary. This must run as source relabel rules: the
// journal source drops __journal_* labels before forwarding, so the
// stage.labels that used to run in loki.process could never see them (it
// produced no level label at all — verified live: systemd streams only ever
// carried job/service_name/detected_level).
loki.relabel "journal_attrs" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["level"]
    regex         = "emerg|alert|crit|panic"
    target_label  = "level"
    replacement   = "fatal"
  }
  rule {
    source_labels = ["level"]
    regex         = "err|error"
    target_label  = "level"
    replacement   = "error"
  }
  rule {
    source_labels = ["level"]
    regex         = "warn|warning"
    target_label  = "level"
    replacement   = "warn"
  }
  rule {
    source_labels = ["level"]
    regex         = "notice|informational|info"
    target_label  = "level"
    replacement   = "info"
  }
  rule {
    source_labels = ["level"]
    regex         = "debug"
    target_label  = "level"
    replacement   = "debug"
  }
}

// Collect systemd journal logs (server syslog)
loki.source.journal "systemd" {
  forward_to = [loki.process.systemd_logs.receiver]
  labels = {
    job = "systemd",
  }
  path = "/var/log/journal"
  max_age = "12h"
  relabel_rules = loki.relabel.journal_attrs.rules
}

// Pass systemd journal logs through (level already set by journal_attrs)
loki.process "systemd_logs" {
  forward_to = [loki.write.loki_endpoint.receiver]
}

// ============================================================================
// SHIP TO LOKI
// ============================================================================

loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}