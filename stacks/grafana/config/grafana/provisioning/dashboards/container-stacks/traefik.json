{
  "title": "Traefik Reverse Proxy",
  "uid": "traefik",
  "tags": ["traefik", "docker", "containers", "reverse-proxy", "http", "tls"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (service) (rate(traefik_service_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Response Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{code=~\"2..\"}[5m]))",
          "legendFormat": "2xx"
        },
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{code=~\"3..\"}[5m]))",
          "legendFormat": "3xx"
        },
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{code=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "title": "Request Rate by Entrypoint",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (entrypoint) (rate(traefik_entrypoint_requests_total[5m]))",
          "legendFormat": "{{entrypoint}}"
        }
      ]
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(traefik_open_connections)", "legendFormat": "connections" }]
    },
    {
      "title": "TLS Certificate Expiry (days)",
      "type": "table",
      "gridPos": { "x": 6, "y": 16, "w": 18, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "(traefik_tls_certs_not_after - time()) / 86400", "legendFormat": "{{cn}}" }
      ]
    }
  ]
}
